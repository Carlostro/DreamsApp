# Copy this file to .env.test and set credentials for disposable test databases only.
NODE_ENV=test
PORT=3100
USE_HTTPS=false

DB_HOST=localhost
DB_USER=REPLACE_WITH_TEST_USER
DB_PASSWORD=REPLACE_WITH_TEST_PASSWORD
DB_NAME=DreamsApp_test
DB_CONNECTION_LIMIT=5

DB_TICKETS_HOST=localhost
DB_TICKETS_USER=REPLACE_WITH_TEST_USER
DB_TICKETS_PASSWORD=REPLACE_WITH_TEST_PASSWORD
DB_TICKETS_NAME=TicketsDB_test

API_URL=http://localhost:3100
PRINTER_PLUGIN_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
