# Configuración del servidor
PORT=3000                    # Puerto HTTP principal (compatible con APK)
HTTPS_API_PORT=3443          # Puerto HTTPS opcional (si se habilita)
FRONTEND_PORT=443            # Puerto HTTPS frontend
HTTP_FRONTEND_PORT=80        # Puerto HTTP frontend (redirección)
NODE_ENV=production

# Habilitar HTTPS adicional (false por defecto - opcional)
# La APK usa HTTP en puerto 3000, el HTTPS es adicional para navegadores web
USE_HTTPS=false

# Dominio público (tunelizado por el router)
DOMAIN=pedidos.cafeteriadreams.com

# URL completa de la API (HTTP - compatible con APK)
API_URL=http://pedidos.cafeteriadreams.com:3000

# Configuración de la base de datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu-password
DB_NAME=DreamsApp
DB_CONNECTION_LIMIT=10

# Base de datos de tickets
DB_TICKETS_HOST=localhost
DB_TICKETS_USER=root
DB_TICKETS_PASSWORD=tu-password
DB_TICKETS_NAME=TicketsDB

# Plugin de impresión (IP local de la impresora)
PRINTER_PLUGIN_URL=http://192.168.x.x:8000

# CORS - Orígenes permitidos (HTTP/HTTPS)
CORS_ORIGINS=http://pedidos.cafeteriadreams.com,https://pedidos.cafeteriadreams.com,http://localhost,https://localhost

# Nota: Las IPs de red local (192.168.x.x, 10.x.x.x) están permitidas automáticamente
# para apps móviles en la misma red WiFi

# Configuración APK móvil:
# La APK está configurada con: http://pedidos.cafeteriadreams.com:3000/api
# Esto funciona tanto desde red local como desde Internet (puerto 3000 abierto en router)
